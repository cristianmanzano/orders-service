{
  "priority": 1,
  "request": {
    "method": "POST",
    "url": "/v1/charges",
    "bodyPatterns": [
      {
        "matchesJsonPath": "$[?(@.amount > 5000)]"
      }
    ]
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "status": "REJECTED",
      "reason": "Amount exceeds the card limit"
    }
  }
}
